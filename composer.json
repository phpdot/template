{
    "name": "phpdot/template",
    "description": "Swoole-safe Twig integration with auto-discovered extensions for the PHPdot ecosystem.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Omar Hamdan",
            "email": "omar@phpdot.com"
        }
    ],
    "keywords": [
        "twig",
        "template",
        "swoole",
        "phpdot"
    ],
    "require": {
        "php": ">=8.5",
        "phpdot/package": "^0.2",
        "psr/container": "^2.0",
        "twig/twig": "^3.10"
    },
    "suggest": {
        "ext-tidy": "Enables the optional HTML formatter (template.format); without it, set template.format to false.",
        "phpdot/container": "Autowires the container-attribute services and #[Config] DTOs declared in src (the attributes stay inert until reflected, so standalone consumers don't need it installed)."
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpdot/config": "^0.2",
        "phpdot/container": "^0.2",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "PHPdot\\Template\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPdot\\Template\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=256M",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@test",
            "@analyse",
            "@cs-check"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "support": {
        "source": "https://github.com/phpdot/template",
        "issues": "https://github.com/phpdot/monorepo/issues"
    }
}
